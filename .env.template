# PHI-Enhanced RLM v4.1 Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# OPEN ROUTER API
# ============================================================================

# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Preferred model (see https://openrouter.ai/models)
# Common options:
# - z-ai/glm-4.7 (Z.AI GLM-4.7 - reasoning model)
# - openai/gpt-4-turbo
# - anthropic/claude-3.5-sonnet
# - google/gemini-pro
DEFAULT_MODEL=z-ai/glm-4.7

# Base URL (usually don't need to change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Timeout in seconds
OPENROUTER_TIMEOUT=120

# Request retry attempts
OPENROUTER_MAX_RETRIES=3

# ============================================================================
# ASYNC BACKEND
# ============================================================================

# Maximum concurrent API requests (async_backend.py)
MAX_CONCURRENT_REQUESTS=5

# ============================================================================
# EMBEDDINGS
# ============================================================================

# Provider: auto | openai | local (auto tries local first, then API)
EMBEDDING_PROVIDER=auto

# API-based embedding model (used when provider is openai or auto-fallback)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# Local embedding model (used when provider is local or auto-preferred)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# SQLite embedding cache
EMBEDDING_CACHE=true
# EMBEDDING_CACHE_DIR=  # Defaults to project directory
